{
  "name": "Go Module Fixture",
  "image": "mcr.microsoft.com/devcontainers/go:1.26",
  "forwardPorts": [8080],
  "postCreateCommand": "go mod download",
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.Go"
      ],
      "settings": {
        "go.useLanguageServer": true,
        "go.formatTool": "gofmt"
      }
    }
  },
  "remoteUser": "vscode"
}
