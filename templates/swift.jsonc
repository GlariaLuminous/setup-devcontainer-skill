{
  "name": "Swift Development",
  "image": "swift:6.0",
  "forwardPorts": [8080],
  "postCreateCommand": "swift package resolve",
  "customizations": {
    "vscode": {
      "extensions": [
        "sswg.swift-lang",
        "vadimcn.vscode-lldb"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "sourcekit-lsp.serverArguments": ["--interruptSignal", "SIGINT"]
      }
    }
  },
  "remoteUser": "vscode",
  "mounts": [
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.ssh,target=/home/vscode/.ssh,type=bind,readonly"
  ]
}
