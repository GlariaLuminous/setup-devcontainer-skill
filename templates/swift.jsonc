{
  "name": "Swift Development",
  "build": {
    "dockerfile": "Swift.Dockerfile",
    "context": ".."
  },
  "forwardPorts": [8080],
  "postCreateCommand": "<install-command>",
  "customizations": {
    "vscode": {
      "extensions": [
        "sswg.swift-lang",
        "vadimcn.vscode-lldb"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "sourcekit-lsp.serverArguments": ["--interruptSignal", "SIGINT"]
      }
    }
  },
  "remoteUser": "vscode"
}
