{
  "name": "Scala Development",
  "image": "mcr.microsoft.com/devcontainers/java:21",
  "features": {
    "ghcr.io/devcontainers-extra/features/sbt-sdkman:2": {
      "jdkVersion": "none"
    }
  },
  "forwardPorts": [8080],
  "postCreateCommand": "sbt update",
  "customizations": {
    "vscode": {
      "extensions": [
        "scala-lang.scala",
        "scalameta.metals",
        "vscjava.vscode-java-pack"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "metals.enabled": true,
        "files.watcherExclude": {
          "**/target/**": true
        }
      }
    }
  },
  "remoteUser": "vscode"
}
