{
  "name": "Ruby Development",
  "image": "mcr.microsoft.com/devcontainers/ruby:3.3",
  "forwardPorts": [3000],
  "postCreateCommand": "bundle install",
  "customizations": {
    "vscode": {
      "extensions": [
        "rebornix.Ruby",
        "ninoseki.vscode-gem-lens",
        "misogi.ruby-rubocop"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "ruby.useLanguageServer": true,
        "ruby.format": "rubocop"
      }
    }
  },
  "remoteUser": "vscode",
  "mounts": [
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.ssh,target=/home/vscode/.ssh,type=bind,readonly"
  ]
}
